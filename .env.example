# Docker Compose loads .env from the project directory. Copy this file to .env.
# API is only published on the host loopback interface.
CAREERPILOT_PORT=8000
# Container database URL and persistent volume are managed in compose.yaml.
# No model or external source enabled in V0.

# Optional V3 GitHub OAuth. Empty values keep binding disabled.
# Configure an OAuth App yourself; never commit real credentials.
CAREERPILOT_GITHUB_CLIENT_ID=
CAREERPILOT_GITHUB_CLIENT_SECRET=
CAREERPILOT_GITHUB_CALLBACK_URL=http://127.0.0.1:8000/app/github-callback.html
# A stable Fernet key; changing it requires all GitHub bindings to reauthorize.
CAREERPILOT_OAUTH_ENCRYPTION_KEY=

# Optional, explicitly invoked CP-222 evaluation adapter only. No default model calls.
# Keep the real key in local .env or the process environment; never paste it into chat/logs.
DEEPSEEK_API_KEY=
